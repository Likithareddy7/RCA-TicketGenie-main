# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# ── Anthropic (all LLM calls: routing, resolution, remediation, breakdown) ──
# Embeddings do NOT come from here — Anthropic has no embeddings endpoint. They
# run locally (all-MiniLM-L6-v2 via onnxruntime), so this is the only AI key needed.
# Without it the app still retrieves, routes deterministically and redirects; only
# the LLM-written prose is lost.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── ServiceNow ──────────────────────────────────────────────────────────
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USER=your-servicenow-user
SERVICENOW_PASSWORD=your-servicenow-password

# OAuth is PREFERRED. ServiceNow's Basic Auth API Restriction blocks Basic auth for
# REST while leaving UI login working — the instance looks healthy in a browser
# while every API call returns 401. Create the client under
# System OAuth -> Application Registry -> Create an OAuth API endpoint for
# external clients. Leave both unset to fall back to Basic auth.
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# The assignment group whose incidents form the queue.
SERVICENOW_QUEUE_GROUP=BOSS OM IT Support
# Optional — overrides the whole incident query.
# SERVICENOW_QUERY=

# ── Knowledge base ──────────────────────────────────────────────────────
# Optional — pins the KB spreadsheet. Default: newest spreadsheet in data/.
# The synthetic dataset is what ships; regenerate with make_synthetic_data.py.
KB_EXCEL_PATH=../data/synthetic closed tickets.xlsx
# KB_EXCEL_SHEET=

# ── Vestigial ───────────────────────────────────────────────────────────
# Unused by the pipeline. Only the /transcribe endpoint touches it, and nothing
# in the current UI calls that.
# OPENAI_API_KEY=
