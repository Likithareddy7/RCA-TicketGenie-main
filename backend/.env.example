# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# ── LLM provider (all prose: routing, resolution, remediation, breakdown) ──
# Embeddings do NOT come from here. They run locally (all-MiniLM-L6-v2 via
# onnxruntime), so retrieval, BM25 and the whole redirect path work with no model
# access at all; only the written prose needs a provider.
#
# "gemini" (default) = Gemini via a Google AI Studio API key.
# "anthropic"        = Claude.
LLM_PROVIDER=gemini

# ── Gemini ──────────────────────────────────────────────────────────────
# A plain API key from https://aistudio.google.com/apikey. No Google Cloud project,
# no gcloud, no service account.
GEMINI_API_KEY=your-gemini-key-here

# Model ids are retired and replaced on Google's schedule, so confirm yours before
# trusting this default:  ../rca/bin/python list_gemini_models.py
GEMINI_MODEL=gemini-3-flash

# ── Anthropic (only used when LLM_PROVIDER=anthropic) ───────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── ServiceNow ──────────────────────────────────────────────────────────
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USER=your-servicenow-user
SERVICENOW_PASSWORD=your-servicenow-password

# OAuth is PREFERRED. ServiceNow's Basic Auth API Restriction blocks Basic auth for
# REST while leaving UI login working — the instance looks healthy in a browser
# while every API call returns 401. Create the client under
# System OAuth -> Application Registry -> Create an OAuth API endpoint for
# external clients. Leave both unset to fall back to Basic auth.
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# The assignment group whose incidents form the internal agent queue, reached by
# typing a bare incident number.
SERVICENOW_QUEUE_GROUP=BOSS OM IT Support
# Optional, overrides the whole incident query.
# SERVICENOW_QUERY=

# The two groups that make up the knowledge base. Both are read when
# KB_SOURCE=servicenow, and a new ticket is filed in whichever group holds the
# closed ticket that best matches it.
#   DEMO_GROUP    the 18 modem/voice tickets, and the fallback when a new ticket's
#                 group cannot be derived
#   SUPPORT_GROUP the 52 Business Hub support tickets
SERVICENOW_DEMO_GROUP=TICKETGENIE DEMO
SERVICENOW_SUPPORT_GROUP=BUS Sales Ordering and Digital Support

# ── Knowledge base ──────────────────────────────────────────────────────
# Where the KB is read from:
#   spreadsheet  reads the file pinned by KB_EXCEL_PATH below. Needs NO ServiceNow
#                instance at all, so this is the quickest way to get the app up.
#   servicenow   reads the closed incidents in the two groups above, so what is
#                visible in the ServiceNow UI is literally what gets searched.
#                Falls back to the spreadsheet when the instance cannot be read.
KB_SOURCE=spreadsheet

# The KB spreadsheet, used when KB_SOURCE=spreadsheet and as the fallback.
# Both of these ship in the repo:
#   ../data/support_kb.xlsx            52 Business Hub support problems
#   ../data/demo_support_tickets.xlsx  18 modem/voice tickets
# Only one can be pinned, so spreadsheet mode serves one set or the other, never
# both. Use KB_SOURCE=servicenow to search all 70 together.
KB_EXCEL_PATH=../data/support_kb.xlsx
# KB_EXCEL_SHEET=
